# Copy to .env and adjust. .env is never committed.
# These are local development values for throwaway containers, not production secrets.

POSTGRES_DB=flowops
POSTGRES_USER=flowops
POSTGRES_PASSWORD=flowops
# 5432 and 5433 are commonly taken by other local PostgreSQL instances.
POSTGRES_HOST_PORT=5434

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

OLLAMA_PORT=11434

# Read by the backend; must agree with the values above.
FLOWOPS_DATASOURCE_URL=jdbc:postgresql://localhost:5434/flowops
FLOWOPS_DATASOURCE_USERNAME=flowops
FLOWOPS_DATASOURCE_PASSWORD=flowops
FLOWOPS_SERVER_PORT=8080

# Where a person's browser reaches this installation, and the origin of every link the product
# emails -- an invitation, a password reset. The backend cannot infer it: a link built from a
# request header is a host-header injection, so it is stated here.
#
# **Change this when the frontend is not on 5173.** Vite moves to 5174 by itself if 5173 is taken,
# and says so on startup. Point this at whatever it printed. If it names a port nothing is listening
# on, the invitation is SENT, the token stays valid for days, and the person clicking the link meets
# a dead page -- which reads as a broken invitation and is nothing of the kind.
FLOWOPS_APP_ORIGIN=http://localhost:5173

# Override one link only where a deployment genuinely serves them from different origins. Ordinarily
# leave both commented and set FLOWOPS_APP_ORIGIN above, so the two cannot be changed apart.
# FLOWOPS_INVITATION_ACCEPT_URL=http://localhost:5173/invitation
# FLOWOPS_RESET_LINK_BASE=http://localhost:5173/reset-password

# --- Real outbound mail -------------------------------------------------------
#
# Leave this whole block commented out and mail goes to Mailpit on localhost:1025,
# where you read it at http://localhost:8025 and nothing leaves the machine. That
# is the default on purpose: development must not be able to write to a real
# person by accident.
#
# Uncomment and fill in to send for real. Gmail, step by step:
#
#   1. The account needs 2-Step Verification on:
#      https://myaccount.google.com/signinoptions/two-step-verification
#   2. Create an App Password (16 characters, shown once):
#      https://myaccount.google.com/apppasswords
#      Your normal Google password will NOT work here and never should.
#   3. Paste it below WITHOUT the spaces Google displays.
#
# FLOWOPS_MAIL_FROM and FLOWOPS_NOTIFICATION_SENDER must both be the mailbox you
# authenticate as. Gmail rewrites or rejects any other sender, so a mismatch does
# not fail loudly -- it silently sends as somebody else or not at all.
#
# .env is git-ignored. An App Password is a credential to your mailbox: it is not
# your Google password, but it reads your mail's outbox all the same. Revoke it at
# the same page if it ever reaches somewhere it should not.
#
# FLOWOPS_MAIL_HOST=smtp.gmail.com
# FLOWOPS_MAIL_PORT=587
# FLOWOPS_MAIL_USERNAME=you@gmail.com
# FLOWOPS_MAIL_PASSWORD=abcdefghijklmnop
# FLOWOPS_MAIL_AUTH=true
# FLOWOPS_MAIL_STARTTLS=true
# FLOWOPS_MAIL_FROM=you@gmail.com
# FLOWOPS_NOTIFICATION_SENDER=you@gmail.com
